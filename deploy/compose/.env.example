# Copy to .env and adjust. Never put secret values here — use ./secrets/ (generated) or a secret manager.

# Address the proxy listens on: 127.0.0.1 = this machine only; 0.0.0.0 = all interfaces (LAN access).
IAM_BIND_ADDRESS=127.0.0.1
IAM_HTTP_PORT=8088

# URL users type in the browser (must match host and port above). Used for OIDC redirects and the Keycloak hostname.
# Example for LAN access: IAM_PUBLIC_URL=http://192.168.136.139:8088
IAM_PUBLIC_URL=http://localhost:8088

# Keycloak user id of the first platform administrator (seeded dev user 'iam-admin'). Used once.
IAM_BOOTSTRAP_ADMIN_SUBJECT=4f0a6d3e-8c1b-4d2a-9e5f-1a2b3c4d5e6f
